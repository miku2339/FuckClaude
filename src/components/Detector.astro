---
import { useTranslations, type Lang } from '../i18n/ui';
import { SIGNALS } from '../config/signals';
import LangToggle from './LangToggle.astro';
import ScoreRing from './ScoreRing.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'zh' ? '/zh/' : '/';
const API_BASE = 'https://fuckclaude.qimake.com/api/check';
const apiExamples = [
  { comment: t('api.ex1'), cmd: `curl ${API_BASE}` },
  { comment: t('api.ex2'), cmd: `curl -H "Accept-Language: zh" ${API_BASE}` },
  { comment: t('api.ex3'), cmd: `curl ${API_BASE}?format=json` },
];

const evidenceCards = [
  {
    tone: 'official',
    label: t('ui.evidence.officialData'),
    title: t('evidence.policy.title'),
    body: t('evidence.policy.body'),
    links: [
      {
        label: t('evidence.policy.link'),
        href: 'https://www.anthropic.com/supported-countries',
      },
      {
        label: t('evidence.location.link'),
        href: 'https://privacy.claude.com/en/articles/11186740-does-claude-use-my-location',
      },
      {
        label: t('evidence.privacy.link'),
        href: 'https://www.anthropic.com/legal/privacy',
      },
    ],
  },
  {
    tone: 'reported',
    label: t('ui.evidence.reported'),
    title: t('evidence.report.title'),
    body: t('evidence.report.body'),
    links: [
      {
        label: t('evidence.report.link'),
        href: 'https://github.com/LinXiaoTao/FuckClaude',
      },
    ],
  },
  {
    tone: 'experimental',
    label: t('ui.evidence.hypothesis'),
    title: t('evidence.hypothesis.title'),
    body: t('evidence.hypothesis.body'),
    links: [],
  },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={home} aria-label={t('nav.title')}>
      <img src="/qim-logo.svg" alt="QIM" width="96" height="32" />
      <span class="brand__divider" aria-hidden="true"></span>
      <span class="brand__product">{t('nav.product')}</span>
    </a>

    <nav class="nav__actions" aria-label="Primary">
      <a class="nav__link" href="#evidence-sec">{t('nav.evidence')}</a>
      <a class="nav__link" href="#how-sec">{t('nav.method')}</a>
      <LangToggle lang={lang} />
      <a
        class="icon-link"
        href="https://github.com/miku233333/FuckClaude"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub · QIM fork"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7 0-.7 0-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <div class="eyebrow">
          <span class="eyebrow__dot" aria-hidden="true"></span>
          {t('hero.eyebrow')}
        </div>
        <h1>{t('hero.title')}</h1>
        <p class="hero__lead">{t('hero.lead')}</p>

        <ul class="trust" aria-label={t('privacy.title')}>
          <li>{t('hero.badge.local')}</li>
          <li>{t('hero.badge.noUpload')}</li>
          <li>{t('hero.badge.openSource')}</li>
        </ul>

        <p class="hero__notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7h.01"></path>
          </svg>
          <span>{t('hero.notice')}</span>
        </p>
        <p class="hero__affiliation">{t('hero.affiliation')}</p>
      </div>

      <div class="detector-card" aria-label={t('score.label')}>
        <div class="detector-card__head">
          <span>{t('score.label')}</span>
          <span class="research-chip">QIM · BETA</span>
        </div>

        <ScoreRing lang={lang} />

        <label class="advanced-optin" for="advanced-optin">
          <input id="advanced-optin" type="checkbox" />
          <span>
            <strong>{t('advanced.title')}</strong>
            <small>{t('advanced.body')}</small>
          </span>
        </label>

        <div class="result" id="result" hidden aria-live="polite">
          <p class="result__title" id="result-title"></p>
          <div class="result__hits" id="result-hits"></div>

          <div class="share" id="share" hidden>
            <span class="share__label">{t('share.label')}</span>
            <div class="share__actions">
              <button class="share__btn share__btn--primary" id="share-native" type="button" hidden data-share="native">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"></path><path d="M16 6l-4-4-4 4M12 2v13"></path></svg>
                <span>{t('share.native')}</span>
              </button>
              <button class="share__btn" id="share-copy" type="button" data-share="copy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span id="share-copy-label">{t('share.copy')}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="evidence-sec" class="section section--tint" aria-labelledby="evidence-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <span class="section-index">01 · EVIDENCE</span>
          <h2 id="evidence-title">{t('evidence.title')}</h2>
        </div>
        <p>{t('evidence.sub')}</p>
      </div>

      <div class="evidence-grid">
        {
          evidenceCards.map((card) => (
            <article class="evidence-card" data-tone={card.tone}>
              <span class="evidence-card__label">{card.label}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              {card.links.length > 0 && (
                <div class="evidence-card__links">
                  {card.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="scan-sec" class="section" aria-labelledby="scan-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <span class="section-index">02 · LOCAL SCAN</span>
          <h2 id="scan-title">{t('signals.title')}</h2>
        </div>
        <p>{t('signals.sub')}</p>
      </div>

      <ol class="scan-list" id="scan">
        {
          SIGNALS.map((signal) => (
            <li class="scan-row is-pending" data-signal={signal.id} data-tier={signal.evidence}>
              <span class="scan-row__icon" set:html={signal.icon} />
              <span class="scan-row__main">
                <span class="scan-row__name">{t(`signal.${signal.id}.name`)}</span>
                <span class="scan-row__desc">{t(`signal.${signal.id}.desc`)}</span>
                <span class="scan-row__meta">
                  <span class="badge" data-tier={signal.evidence}>{t(`ui.evidence.${signal.evidence}`)}</span>
                  <span class="badge badge--weight">
                    {signal.weight > 0 ? `${t('ui.weight')} ${signal.weight}` : t('ui.contextOnly')}
                  </span>
                  {signal.intrusive && <span class="badge badge--optional">{t('advanced.badge')}</span>}
                </span>
              </span>
              <span class="scan-row__status">
                <span class="scan-row__value" data-field="value"></span>
                <span class="scan-row__contrib" data-field="contribution"></span>
                <span class="dot" data-field="dot"></span>
                <span class="spinner" aria-hidden="true"></span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="hypotheses-sec" class="section section--dark" aria-labelledby="hypotheses-title">
    <div class="wrap">
      <div class="section-head section-head--split section-head--inverse">
        <div>
          <span class="section-index">03 · HYPOTHESIS LAB</span>
          <h2 id="hypotheses-title">{t('hypotheses.title')}</h2>
        </div>
        <p>{t('hypotheses.sub')}</p>
      </div>

      <div class="hypothesis-grid">
        <article class="hypothesis-card" data-hypothesis="cluster" data-state="pending">
          <div class="hypothesis-card__top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="6" cy="6" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="12" cy="18" r="2"></circle><path d="m7.7 7.1 3.1 8.5M16.3 7.1l-3.1 8.5M8 6h8"></path></svg>
            <span data-field="status">{t('hypotheses.pending')}</span>
          </div>
          <h3>{t('hypotheses.cluster.title')}</h3>
          <p>{t('hypotheses.cluster.body')}</p>
          <output data-field="value">—</output>
        </article>

        <article class="hypothesis-card" data-hypothesis="software" data-state="pending">
          <div class="hypothesis-card__top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M8 22h8M12 18v4"></path></svg>
            <span data-field="status">{t('hypotheses.pending')}</span>
          </div>
          <h3>{t('hypotheses.software.title')}</h3>
          <p>{t('hypotheses.software.body')}</p>
          <output data-field="value">—</output>
        </article>

        <article class="hypothesis-card" data-hypothesis="network" data-state="pending">
          <div class="hypothesis-card__top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.4 3 14.6 0 18M12 3c-3 3.4-3 14.6 0 18"></path></svg>
            <span data-field="status">{t('hypotheses.pending')}</span>
          </div>
          <h3>{t('hypotheses.network.title')}</h3>
          <p>{t('hypotheses.network.body')}</p>
          <output data-field="value">—</output>
        </article>
      </div>

      <p class="hypothesis-footnote">{t('hypotheses.footnote')}</p>
    </div>
  </section>

  <section id="account-sec" class="section" aria-labelledby="account-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <span class="section-index">04 · OUTSIDE THE BROWSER</span>
          <h2 id="account-title">{t('account.title')}</h2>
        </div>
        <p>{t('account.sub')}</p>
      </div>

      <div class="manual-grid">
        {['phone', 'billing', 'identity', 'egress'].map((item) => (
          <article class="manual-card">
            <span>{t('account.manual')}</span>
            <h3>{t(`account.${item}.title`)}</h3>
            <p>{t(`account.${item}.body`)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how-sec" class="section section--tint" aria-labelledby="how-title">
    <div class="wrap method-grid">
      <div>
        <span class="section-index">05 · METHOD & PRIVACY</span>
        <h2 id="how-title">{t('how.title')}</h2>
      </div>
      <div class="method-copy">
        <p>{t('how.p1')}</p>
        <p>{t('how.p2')}</p>

        <div class="privacy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
          <div>
            <h3>{t('privacy.title')}</h3>
            <p>{t('privacy.body')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="api-sec" class="section" aria-labelledby="api-title">
    <div class="wrap api-grid">
      <div class="section-head">
        <span class="section-index">06 · EDGE API</span>
        <h2 id="api-title">{t('api.title')}</h2>
        <p>{t('api.desc')}</p>
      </div>

      <div class="api-cmd">
        <div class="api-cmd__bar">
          <span>api/check</span>
          <button class="api-cmd__copy" id="api-copy" type="button" data-copy={`curl ${API_BASE}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span id="api-copy-label">{t('share.copy')}</span>
          </button>
        </div>
        <div class="api-cmd__code">
          {apiExamples.map((ex) => (
            <div class="api-cmd__block">
              <span class="api-cmd__comment">{ex.comment}</span>
              <code><span aria-hidden="true">$</span> {ex.cmd}</code>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="faq-sec" class="section section--tint" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <span class="section-index">07 · FAQ</span>
        <h2 id="faq-title">{t('faq.title')}</h2>
      </div>
      <div class="faq">
        {[1, 2, 3, 4].map((i) => (
          <details>
            <summary>{t(`faq.q${i}`)}</summary>
            <p>{t(`faq.a${i}`)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="public-sec" class="section public-section" aria-labelledby="public-title">
    <div class="wrap public-card">
      <div class="public-card__brand">
        <img src="/qim-logo-dark.svg" alt="QIM" width="120" height="40" />
        <span>{t('hero.eyebrow')}</span>
      </div>
      <div class="public-card__copy">
        <h2 id="public-title">{t('public.title')}</h2>
        <p>{t('public.body')}</p>
        <details>
          <summary>{t('public.disclaimer.title')}</summary>
          <p>{t('public.disclaimer.body')}</p>
        </details>
      </div>
    </div>
  </section>
</main>

<Footer lang={lang} />

<script>
  import '../scripts/detect';
</script>
