---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <img src="/qim-logo-dark.svg" alt="QIM" width="96" height="32" />
      <p>{t('footer.disclaimer')}</p>
    </div>

    <div class="footer__legal">
      <p>{t('footer.trademark')}</p>
      <p>{t('footer.license')}</p>
    </div>

    <nav class="footer__links" aria-label="Project links">
      <a href="https://qimake.com" target="_blank" rel="noopener noreferrer">{t('footer.qim')} ↗</a>
      <a href="https://github.com/miku233333/FuckClaude" target="_blank" rel="noopener noreferrer">{t('footer.fork')} ↗</a>
      <a href="https://github.com/LinXiaoTao/FuckClaude" target="_blank" rel="noopener noreferrer">{t('footer.repo')} ↗</a>
    </nav>
  </div>
</footer>
